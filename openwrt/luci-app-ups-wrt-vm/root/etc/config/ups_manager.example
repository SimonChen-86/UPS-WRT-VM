# ==============================================================================
# UPS-WRT-VM 智能供电与网络安全关机中心 - UCI 配置文件范例
# 存放路径: /etc/config/ups_manager
# ==============================================================================

config settings 'main'
	# --------------------------------------------------------------------------
	# 1. 核心联动总开关
	# 1 = 启用智能关机联动保护；0 = 暂停自动关机 (日常电路维护或拔插头测试时使用)
	# --------------------------------------------------------------------------
	option enabled '1'

	# --------------------------------------------------------------------------
	# 2. 市电断电防抖等待时间 (单位: 秒，默认 180 秒)
	# 检测到市电中断并切入电池供电后启动倒计时，若在此时间内市电恢复，系统会自动撤销关机
	# --------------------------------------------------------------------------
	option onbatt_wait_seconds '180'
	option onbatt_delay '180'

	# --------------------------------------------------------------------------
	# 3. 业务虚拟机落盘等待超时 (单位: 秒，默认 150 秒)
	# 向 ESXi 非软路由业务虚拟机 (如 Windows Server / Linux) 发送优雅关机后的最大轮询等待时间
	# 若超过此时间业务机仍未关机，将执行强制断电保底，防止个别程序挂起耗尽电池
	# --------------------------------------------------------------------------
	option vm_shutdown_timeout '150'

	# --------------------------------------------------------------------------
	# 4. 低电量 (LOWBATT) 即时触发熔断保护
	# 1 = 开启；0 = 关闭。极端情况下若电池严重老化或负载骤增触发 LOWBATT，跳过防抖倒计时立即关机
	# --------------------------------------------------------------------------
	option lowbatt_instant_shutdown '1'
	option lowbatt_shutdown '1'

	# --------------------------------------------------------------------------
	# 5. VMware ESXi 宿主机连接配置
	# 目标虚拟化宿主机的内网管理 IPv4 地址与管理员用户名 (默认 root)
	# --------------------------------------------------------------------------
	option esxi_host '192.168.1.100'
	option esxi_ip '192.168.1.100'
	option esxi_user 'root'

	# --------------------------------------------------------------------------
	# 6. NUT (Network UPS Tools) 本地/远程服务端连接凭据
	# 默认连接软路由本地运行的 nut-server 守护进程 (127.0.0.1:3493)
	# --------------------------------------------------------------------------
	option nut_host '127.0.0.1'
	option nut_port '3493'
	option nut_upsname 'ups'
	option nut_user 'monuser'
	option nut_password 'secret123'

	# --------------------------------------------------------------------------
	# 7. 全链路持久化审计日志存储路径
	# 位于 /overlay 闪存持久卷，系统断电关机或重启后日志永不丢失
	# --------------------------------------------------------------------------
	option log_file '/etc/ups_manager/ups_events.log'

